// 1 = exe 圖示（ID 最小者 Explorer 會拿來當應用程式圖示），2/3 = 托盤 on/off
1 ICON "icon\\app\\256x256.ico"
2 ICON "icon\\on\\32x32.ico"
3 ICON "icon\\off\\32x32.ico"

1 24 "app.manifest"

// 檔案內容 → 詳細資料。VER_* 由 build.rs 從 Cargo.toml 傳入。
// FileDescription 也是工作列圖示設定頁、工作管理員顯示的名稱。
1 VERSIONINFO
FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ClipboardApp"
            VALUE "ProductName", "ClipboardApp"
            VALUE "FileVersion", VER_STR
            VALUE "ProductVersion", VER_STR
            VALUE "CompanyName", VER_AUTHOR
            VALUE "OriginalFilename", "ClipboardApp.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
